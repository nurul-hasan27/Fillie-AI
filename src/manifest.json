{
  "manifest_version": 3,
  "name": "Fillie — Personal AI Form Assistant",
  "short_name": "Fillie",
  "version": "1.1.0",
  "description": "Fillie understands online forms, answers them from your profile and learned answers, and never submits anything without you.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Fillie — fill this form",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "pages/app.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "identity", "alarms", "notifications"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.together.xyz/*",
    "https://api.cerebras.ai/*",
    "https://*.supabase.co/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/auth-callback.html"],
      "matches": ["https://*/*", "http://127.0.0.1/*"]
    }
  ],
  "commands": {
    "run-fillie": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Run Fillie on the current page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}